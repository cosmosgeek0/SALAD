{
  "exec": {
    "command": ["/bin/bash", "-c", "read -r last < /tmp/earnapp-heartbeat && [[ $last =~ ^[0-9]+$ ]] && (( EPOCHSECONDS >= last && EPOCHSECONDS-last <= 45 ))"]
  },
  "initial_delay_seconds": 120,
  "period_seconds": 10,
  "timeout_seconds": 5,
  "failure_threshold": 3,
  "success_threshold": 1
}
