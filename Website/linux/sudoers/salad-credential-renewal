# Only fixed renewal entry points; no shell, interpreter -c, or secret reads.
Cmnd_Alias SALAD_PROVIDER_UNITS = /usr/bin/systemctl stop salad-repocket-provider.service, /usr/bin/systemctl start salad-repocket-provider.service, /usr/bin/systemctl stop salad-packetstream-provider.service, /usr/bin/systemctl start salad-packetstream-provider.service
Cmnd_Alias SALAD_SESSION_WRITES = /opt/salad/.runtime/keychain-store --service repocket-provider-session --account salad, /opt/salad/.runtime/keychain-store --service packetstream-provider-session --account salad
Cmnd_Alias SALAD_RP_PROMPTS = /usr/bin/python3 -B /opt/salad/scripts/save-provider-access.py --mode email_password, /usr/bin/python3 -B /opt/salad/scripts/save-provider-access.py --mode refresh_token, /usr/bin/python3 -B /opt/salad/scripts/save-provider-access.py --check
Cmnd_Alias SALAD_SECRET_PROMPTS = /usr/bin/python3 -B /opt/salad/scripts/save-secret.py salad-bandwidth-api, /usr/bin/python3 -B /opt/salad/scripts/save-secret.py proxyrack-peer-api, /usr/bin/python3 -B /opt/salad/scripts/save-secret.py earnfm-read-session, /usr/bin/python3 -B /opt/salad/scripts/save-secret.py salad-traffmonetizer-session
ubuntu ALL=(root) NOPASSWD: SALAD_PROVIDER_UNITS
ubuntu ALL=(salad) NOPASSWD: SALAD_SESSION_WRITES, SALAD_RP_PROMPTS, SALAD_SECRET_PROMPTS
