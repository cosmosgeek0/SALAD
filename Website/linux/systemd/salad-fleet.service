[Unit]
Description=Salad fleet
Wants=network-online.target
After=network-online.target

[Service]
User=salad
Group=salad
WorkingDirectory=/opt/salad
Environment=PYTHONPATH=/opt/salad
Environment=HG_FLEET_DIR=/home/salad/.hg1/hg-fleet
ExecStart=/usr/bin/python3 -B fleet-test-recorder.py run
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=salad-credentials
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/home/salad/.hg1 /run/salad-credentials
ReadOnlyPaths=/home/salad/.hg1/hg-fleet /home/salad/.hg1/packetstream /home/salad/.hg1/proxyrack /home/salad/.hg1/repocket /home/salad/.hg1/earnfm /home/salad/.hg1/traffmonetizer /home/salad/.hg1/earnapp /home/salad/.hg1/pawns /home/salad/.hg1/grass /home/salad/.hg1/bandwidth.sqlite3
InaccessiblePaths=/etc/cloudflared-salad /run/salad-ui

[Install]
WantedBy=multi-user.target
